{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["request_id", "status", "message", "data", "trace"],
  "properties": {
    "request_id": {"type": "string", "format": "uuid"},
    "status": {"enum": ["success", "pending", "refused", "needs_input", "invalid", "error", "limit"]},
    "message": {"type": "string", "maxLength": 200},
    "data": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "decision_id": {"type": "string", "format": "uuid"},
        "version": {"type": "integer", "minimum": 1},
        "proposed_arguments": {"$ref": "#/$defs/student"},
        "students": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/student"}}
      }
    },
    "trace": {
      "type": "array", "minItems": 1, "maxItems": 10,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["step", "stage", "action", "code"],
        "properties": {
          "step": {"type": "integer", "minimum": 0, "maximum": 3},
          "stage": {"enum": ["select", "act", "observe", "stop"]},
          "action": {"enum": ["none", "read_database", "save_database", "finish", "clarify", "refuse"]},
          "code": {"type": "string", "pattern": "^[a-z0-9_]+$", "maxLength": 50}
        }
      }
    }
  },
  "$defs": {
    "student": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "email", "major", "gpa", "enrollment_date"],
      "properties": {
        "id": {"type": "integer", "minimum": 1},
        "name": {"type": "string", "maxLength": 200},
        "email": {"type": "string", "maxLength": 254},
        "major": {"type": "string", "maxLength": 200},
        "gpa": {"type": "number", "minimum": 0, "maximum": 4},
        "enrollment_date": {"type": "string", "maxLength": 10}
      }
    }
  }
}
