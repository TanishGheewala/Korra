# Python cache and bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
venv/
env/
ENV/
.venv

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Git files
.git/
.gitignore

# Documentation
README.md
*.md

# Output files
output/
*.png
*.log

# OS files
.DS_Store
Thumbs.db

# Docker files (don't copy these into the image)
Dockerfile
docker-compose.yml
.dockerignore

.env
.env.*